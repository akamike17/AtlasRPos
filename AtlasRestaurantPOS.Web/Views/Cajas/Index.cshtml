@{
    ViewData["Title"] = "Cajas";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Cajas</h1>
    <button type="button" class="btn btn-primary" onclick="window.abrirModal()">Nuevo</button>
</div>

<div class="mb-3">
    <input type="text" id="buscar" class="form-control" placeholder="Buscar por código, nombre, sucursal o empresa..." />
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Empresa</th>
                <th>Sucursal</th>
                <th>Código</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Estatus</th>
                <th>Fecha</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-cajas"></tbody>
    </table>
</div>

<div class="modal fade" id="modalCaja" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formCaja" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModal">Nueva caja</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="IdCaja" />
                    <div class="mb-3">
                        <label class="form-label" for="IdSucursal">Sucursal *</label>
                        <select id="IdSucursal" class="form-select"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Codigo">Código *</label>
                        <input type="text" id="Codigo" class="form-control" maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Nombre">Nombre *</label>
                        <input type="text" id="Nombre" class="form-control" maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Descripcion">Descripción</label>
                        <input type="text" id="Descripcion" class="form-control" maxlength="500" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Toast")

@section Scripts {
<script>
(function () {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const modal = document.getElementById('modalCaja');
    const selectSucursal = document.getElementById('IdSucursal');
    let debounceTimer = null;

    const headers = {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
    };

    async function respuestaJson(res) {
        if (res.status === 401) { window.location.href = '/Acceso/Login'; return null; }
        if (res.status === 403) { mostrarToast('Acceso denegado.', 'error'); return null; }
        if (!res.ok) { mostrarToast('Error en la solicitud.', 'error'); return null; }
        return res.json();
    }

    async function cargar(termino) {
        const url = '/Cajas/Buscar?termino=' + encodeURIComponent(termino);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (data) renderizar(data);
        } catch (e) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    function renderizar(lista) {
        const tbody = document.getElementById('tabla-cajas');
        tbody.innerHTML = '';
        if (!lista.length) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center">Sin resultados</td></tr>';
            return;
        }
        lista.forEach(c => {
            const tr = document.createElement('tr');
            const badge = c.activo
                ? '<span class="badge bg-success">Activo</span>'
                : '<span class="badge bg-secondary">Inactivo</span>';
            const botonEstatus = c.activo
                ? '<button type="button" class="btn btn-sm btn-outline-warning" onclick="window.cambiarEstatus(' + c.idCaja + ', false)">Inactivar</button>'
                : '<button type="button" class="btn btn-sm btn-outline-success" onclick="window.cambiarEstatus(' + c.idCaja + ', true)">Activar</button>';
            tr.innerHTML = '<td>' + c.idCaja + '</td>' +
                '<td>' + escapeHtml(c.empresa) + '</td>' +
                '<td>' + escapeHtml(c.sucursal) + '</td>' +
                '<td>' + escapeHtml(c.codigo) + '</td>' +
                '<td>' + escapeHtml(c.nombre) + '</td>' +
                '<td>' + escapeHtml(c.descripcion || '') + '</td>' +
                '<td>' + badge + '</td>' +
                '<td>' + new Date(c.fechaCreacion).toLocaleDateString() + '</td>' +
                '<td class="text-end text-nowrap">' +
                '<button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="window.editar(' + c.idCaja + ')">Editar</button>' +
                botonEstatus +
                '</td>';
            tbody.appendChild(tr);
        });
    }

    async function cargarSucursales() {
        try {
            const res = await fetch('/Sucursales/Buscar', { headers });
            const data = await respuestaJson(res);
            if (!data) return;
            selectSucursal.innerHTML = '<option value="">Seleccione...</option>';
            data.filter(s => s.activo).forEach(s => {
                const op = document.createElement('option');
                op.value = s.idSucursal;
                op.textContent = s.nombre + ' (' + s.empresa + ')';
                selectSucursal.appendChild(op);
            });
        } catch (err) {
            mostrarToast('Error al cargar sucursales.', 'error');
        }
    }

    function abrirModal() {
        document.getElementById('formCaja').reset();
        document.getElementById('IdCaja').value = '';
        document.getElementById('tituloModal').textContent = 'Nueva caja';
        new bootstrap.Modal(modal).show();
    }

    async function editar(id) {
        const url = '/Cajas/Buscar?termino=' + encodeURIComponent(id);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (!data) return;
            const c = data.find(x => x.idCaja === id);
            if (!c) { mostrarToast('No se encontró el registro.', 'error'); return; }
            document.getElementById('IdCaja').value = c.idCaja;
            document.getElementById('IdSucursal').value = c.idSucursal;
            document.getElementById('Codigo').value = c.codigo;
            document.getElementById('Nombre').value = c.nombre;
            document.getElementById('Descripcion').value = c.descripcion || '';
            document.getElementById('tituloModal').textContent = 'Editar caja';
            new bootstrap.Modal(modal).show();
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function guardar() {
        const id = document.getElementById('IdCaja').value;
        const payload = {
            idCaja: id ? parseInt(id, 10) : 0,
            idSucursal: parseInt(document.getElementById('IdSucursal').value, 10) || 0,
            codigo: document.getElementById('Codigo').value,
            nombre: document.getElementById('Nombre').value,
            descripcion: document.getElementById('Descripcion').value
        };
        const url = payload.idCaja ? '/Cajas/Editar' : '/Cajas/Crear';
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }),
                body: JSON.stringify(payload)
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                bootstrap.Modal.getInstance(modal).hide();
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function cambiarEstatus(id, activar) {
        const accion = activar ? '¿Activar la caja?' : '¿Inactivar la caja?';
        if (!confirm(accion)) return;
        const url = activar ? '/Cajas/Activar?id=' + id : '/Cajas/Inactivar?id=' + id;
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, { 'RequestVerificationToken': token })
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    window.cambiarEstatus = cambiarEstatus;
    window.editar = editar;
    window.abrirModal = abrirModal;

    document.getElementById('formCaja').addEventListener('submit', function (ev) {
        ev.preventDefault();
        guardar();
    });

    document.getElementById('buscar').addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
            cargar(this.value.trim());
        }.bind(this), 300);
    });

    cargarSucursales();
    cargar('');
})();
</script>
}