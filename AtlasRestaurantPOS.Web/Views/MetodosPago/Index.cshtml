@{
    ViewData["Title"] = "Métodos de Pago";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Métodos de pago</h1>
    <button type="button" class="btn btn-primary" onclick="window.abrirModal()">Nuevo</button>
</div>

<div class="mb-3">
    <input type="text" id="buscar" class="form-control" placeholder="Buscar por nombre o código..." />
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Empresa</th>
                <th>Nombre</th>
                <th>Código</th>
                <th>Requiere referencia</th>
                <th>Permite cambio</th>
                <th>Estatus</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-metodos"></tbody>
    </table>
</div>

<div class="modal fade" id="modalMetodo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formMetodo" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModal">Nuevo método de pago</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="IdMetodoPago" />
                    <div class="mb-3">
                        <label class="form-label" for="Nombre">Nombre *</label>
                        <input type="text" id="Nombre" class="form-control" maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Codigo">Código *</label>
                        <input type="text" id="Codigo" class="form-control" maxlength="50" />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" class="form-check-input" id="RequiereReferencia" />
                        <label class="form-check-label" for="RequiereReferencia">Requiere referencia</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" class="form-check-input" id="PermiteCambio" />
                        <label class="form-check-label" for="PermiteCambio">Permite cambio</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Toast")

@section Scripts {
<script>
(function () {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const modal = document.getElementById('modalMetodo');
    let debounceTimer = null;

    const headers = {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
    };

    async function respuestaJson(res) {
        if (res.status === 401) { window.location.href = '/Acceso/Login'; return null; }
        if (res.status === 403) { mostrarToast('Acceso denegado.', 'error'); return null; }
        if (!res.ok) { mostrarToast('Error en la solicitud.', 'error'); return null; }
        return res.json();
    }

    async function cargar(termino) {
        const url = '/MetodosPago/Buscar?termino=' + encodeURIComponent(termino);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (data) renderizar(data);
        } catch (e) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    function renderizar(lista) {
        const tbody = document.getElementById('tabla-metodos');
        tbody.innerHTML = '';
        if (!lista.length) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center">Sin resultados</td></tr>';
            return;
        }
        lista.forEach(m => {
            const tr = document.createElement('tr');
            const badge = m.activo
                ? '<span class="badge bg-success">Activo</span>'
                : '<span class="badge bg-secondary">Inactivo</span>';
            const botonEstatus = m.activo
                ? '<button type="button" class="btn btn-sm btn-outline-warning" onclick="window.cambiarEstatus(' + m.idMetodoPago + ', false)">Inactivar</button>'
                : '<button type="button" class="btn btn-sm btn-outline-success" onclick="window.cambiarEstatus(' + m.idMetodoPago + ', true)">Activar</button>';
            tr.innerHTML = '<td>' + m.idMetodoPago + '</td>' +
                '<td>' + escapeHtml(m.empresa) + '</td>' +
                '<td>' + escapeHtml(m.nombre) + '</td>' +
                '<td>' + escapeHtml(m.codigo) + '</td>' +
                '<td>' + (m.requiereReferencia ? 'Sí' : 'No') + '</td>' +
                '<td>' + (m.permiteCambio ? 'Sí' : 'No') + '</td>' +
                '<td>' + badge + '</td>' +
                '<td class="text-end text-nowrap">' +
                '<button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="window.editar(' + m.idMetodoPago + ')">Editar</button>' +
                botonEstatus +
                '</td>';
            tbody.appendChild(tr);
        });
    }

    function abrirModal() {
        document.getElementById('formMetodo').reset();
        document.getElementById('IdMetodoPago').value = '';
        document.getElementById('RequiereReferencia').checked = false;
        document.getElementById('PermiteCambio').checked = false;
        document.getElementById('tituloModal').textContent = 'Nuevo método de pago';
        new bootstrap.Modal(modal).show();
    }

    async function editar(id) {
        const url = '/MetodosPago/Buscar?termino=' + encodeURIComponent(id);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (!data) return;
            const m = data.find(x => x.idMetodoPago === id);
            if (!m) { mostrarToast('No se encontró el registro.', 'error'); return; }
            document.getElementById('IdMetodoPago').value = m.idMetodoPago;
            document.getElementById('Nombre').value = m.nombre;
            document.getElementById('Codigo').value = m.codigo;
            document.getElementById('RequiereReferencia').checked = m.requiereReferencia;
            document.getElementById('PermiteCambio').checked = m.permiteCambio;
            document.getElementById('tituloModal').textContent = 'Editar método de pago';
            new bootstrap.Modal(modal).show();
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function guardar() {
        const id = document.getElementById('IdMetodoPago').value;
        const payload = {
            idMetodoPago: id ? parseInt(id, 10) : 0,
            nombre: document.getElementById('Nombre').value,
            codigo: document.getElementById('Codigo').value,
            requiereReferencia: document.getElementById('RequiereReferencia').checked,
            permiteCambio: document.getElementById('PermiteCambio').checked
        };
        const url = payload.idMetodoPago ? '/MetodosPago/Editar' : '/MetodosPago/Crear';
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }),
                body: JSON.stringify(payload)
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                bootstrap.Modal.getInstance(modal).hide();
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function cambiarEstatus(id, activar) {
        const accion = activar ? '¿Activar el método de pago?' : '¿Inactivar el método de pago?';
        if (!confirm(accion)) return;
        const url = activar ? '/MetodosPago/Activar?id=' + id : '/MetodosPago/Inactivar?id=' + id;
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, { 'RequestVerificationToken': token })
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    window.cambiarEstatus = cambiarEstatus;
    window.editar = editar;
    window.abrirModal = abrirModal;

    document.getElementById('formMetodo').addEventListener('submit', function (ev) {
        ev.preventDefault();
        guardar();
    });

    document.getElementById('buscar').addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
            cargar(this.value.trim());
        }.bind(this), 300);
    });

    cargar('');
})();
</script>
}