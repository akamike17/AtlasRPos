@{
    ViewData["Title"] = "Productos";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Productos</h1>
    <button type="button" class="btn btn-primary" onclick="window.abrirModal()">Nuevo</button>
</div>

<div class="mb-3">
    <input type="text" id="buscar" class="form-control" placeholder="Buscar por nombre, descripción o categoría..." />
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Categoría</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Precio</th>
                <th>Impuestos</th>
                <th>Estatus</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-productos"></tbody>
    </table>
</div>

<div class="modal fade" id="modalProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formProducto" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModal">Nuevo producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="IdProducto" />
                    <div class="mb-3">
                        <label class="form-label" for="IdCategoriaProducto">Categoría *</label>
                        <select id="IdCategoriaProducto" class="form-select"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Nombre">Nombre *</label>
                        <input type="text" id="Nombre" class="form-control" maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Precio">Precio *</label>
                        <input type="number" id="Precio" class="form-control" step="0.01" min="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Descripcion">Descripción</label>
                        <textarea id="Descripcion" class="form-control" maxlength="500" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalImpuestos" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalImpuestos">Impuestos del producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ImpuestosIdProducto" />
                <h6 class="text-muted">Asignados</h6>
                <ul class="list-group mb-3" id="lista-asignados"></ul>
                <h6 class="text-muted">Disponibles</h6>
                <ul class="list-group" id="lista-disponibles"></ul>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Toast")

@section Scripts {
<script>
(function () {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const modal = document.getElementById('modalProducto');
    const modalImpuestos = document.getElementById('modalImpuestos');
    const selectCategoria = document.getElementById('IdCategoriaProducto');
    let debounceTimer = null;

    const headers = {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
    };

    async function respuestaJson(res) {
        if (res.status === 401) { window.location.href = '/Acceso/Login'; return null; }
        if (res.status === 403) { mostrarToast('Acceso denegado.', 'error'); return null; }
        if (!res.ok) { mostrarToast('Error en la solicitud.', 'error'); return null; }
        return res.json();
    }

    async function cargar(termino) {
        const url = '/Productos/Buscar?termino=' + encodeURIComponent(termino);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (data) renderizar(data);
        } catch (e) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    function renderizar(lista) {
        const tbody = document.getElementById('tabla-productos');
        tbody.innerHTML = '';
        if (!lista.length) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center">Sin resultados</td></tr>';
            return;
        }
        lista.forEach(p => {
            const tr = document.createElement('tr');
            const badge = p.activo
                ? '<span class="badge bg-success">Activo</span>'
                : '<span class="badge bg-secondary">Inactivo</span>';
            const botonEstatus = p.activo
                ? '<button type="button" class="btn btn-sm btn-outline-warning" onclick="window.cambiarEstatus(' + p.idProducto + ', false)">Inactivar</button>'
                : '<button type="button" class="btn btn-sm btn-outline-success" onclick="window.cambiarEstatus(' + p.idProducto + ', true)">Activar</button>';
            tr.innerHTML = '<td>' + p.idProducto + '</td>' +
                '<td>' + escapeHtml(p.categoria) + '</td>' +
                '<td>' + escapeHtml(p.nombre) + '</td>' +
                '<td>' + escapeHtml(p.descripcion || '') + '</td>' +
                '<td>' + Number(p.precio).toFixed(2) + '</td>' +
                '<td>' +
                '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.gestionarImpuestos(' + p.idProducto + ')">Impuestos (' + p.cantidadImpuestos + ')</button>' +
                '</td>' +
                '<td>' + badge + '</td>' +
                '<td class="text-end text-nowrap">' +
                '<button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="window.editar(' + p.idProducto + ')">Editar</button>' +
                botonEstatus +
                '</td>';
            tbody.appendChild(tr);
        });
    }

    async function cargarCategorias() {
        try {
            const res = await fetch('/Categorias/Buscar', { headers });
            const data = await respuestaJson(res);
            if (!data) return;
            selectCategoria.innerHTML = '<option value="">Seleccione...</option>';
            data.filter(c => c.activo).forEach(c => {
                const op = document.createElement('option');
                op.value = c.idCategoriaProducto;
                op.textContent = c.nombre;
                selectCategoria.appendChild(op);
            });
        } catch (err) {
            mostrarToast('Error al cargar categorías.', 'error');
        }
    }

    function abrirModal() {
        document.getElementById('formProducto').reset();
        document.getElementById('IdProducto').value = '';
        document.getElementById('tituloModal').textContent = 'Nuevo producto';
        new bootstrap.Modal(modal).show();
    }

    async function editar(id) {
        const url = '/Productos/Buscar?termino=' + encodeURIComponent(id);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (!data) return;
            const p = data.find(x => x.idProducto === id);
            if (!p) { mostrarToast('No se encontró el registro.', 'error'); return; }
            document.getElementById('IdProducto').value = p.idProducto;
            document.getElementById('IdCategoriaProducto').value = p.idCategoriaProducto;
            document.getElementById('Nombre').value = p.nombre;
            document.getElementById('Precio').value = p.precio;
            document.getElementById('Descripcion').value = p.descripcion || '';
            document.getElementById('tituloModal').textContent = 'Editar producto';
            new bootstrap.Modal(modal).show();
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function guardar() {
        const id = document.getElementById('IdProducto').value;
        const payload = {
            idProducto: id ? parseInt(id, 10) : 0,
            idCategoriaProducto: parseInt(document.getElementById('IdCategoriaProducto').value, 10) || 0,
            nombre: document.getElementById('Nombre').value,
            descripcion: document.getElementById('Descripcion').value,
            precio: parseFloat(document.getElementById('Precio').value) || 0
        };
        const url = payload.idProducto ? '/Productos/Editar' : '/Productos/Crear';
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }),
                body: JSON.stringify(payload)
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                bootstrap.Modal.getInstance(modal).hide();
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function cambiarEstatus(id, activar) {
        const accion = activar ? '¿Activar el producto?' : '¿Inactivar el producto?';
        if (!confirm(accion)) return;
        const url = activar ? '/Productos/Activar?id=' + id : '/Productos/Inactivar?id=' + id;
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, { 'RequestVerificationToken': token })
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function gestionarImpuestos(idProducto) {
        try {
            const res = await fetch('/Productos/ObtenerImpuestos?idProducto=' + idProducto, { headers });
            const data = await respuestaJson(res);
            if (!data) return;
            document.getElementById('ImpuestosIdProducto').value = idProducto;
            const asignados = document.getElementById('lista-asignados');
            const disponibles = document.getElementById('lista-disponibles');
            asignados.innerHTML = '';
            disponibles.innerHTML = '';
            if (!data.asignados.length) {
                asignados.innerHTML = '<li class="list-group-item text-muted">Sin impuestos asignados</li>';
            }
            data.asignados.forEach(i => {
                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center';
                li.innerHTML = '<span>' + escapeHtml(i.nombre) + ' (' + Number(i.tasa).toFixed(2) + '%)</span>';
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-sm btn-outline-danger';
                btn.textContent = 'Quitar';
                btn.onclick = function () { quitarImpuesto(idProducto, i.idImpuesto); };
                li.appendChild(btn);
                asignados.appendChild(li);
            });
            if (!data.disponibles.length) {
                disponibles.innerHTML = '<li class="list-group-item text-muted">Sin impuestos disponibles</li>';
            }
            data.disponibles.forEach(i => {
                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center';
                li.innerHTML = '<span>' + escapeHtml(i.nombre) + ' (' + Number(i.tasa).toFixed(2) + '%)</span>';
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-sm btn-outline-success';
                btn.textContent = 'Asignar';
                btn.onclick = function () { asignarImpuesto(idProducto, i.idImpuesto); };
                li.appendChild(btn);
                disponibles.appendChild(li);
            });
            new bootstrap.Modal(modalImpuestos).show();
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function asignarImpuesto(idProducto, idImpuesto) {
        const payload = { idProducto: idProducto, idImpuesto: idImpuesto };
        try {
            const res = await fetch('/Productos/AsignarImpuesto', {
                method: 'POST',
                headers: Object.assign({}, headers, {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }),
                body: JSON.stringify(payload)
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                gestionarImpuestos(idProducto);
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function quitarImpuesto(idProducto, idImpuesto) {
        if (!confirm('¿Quitar el impuesto del producto?')) return;
        const payload = { idProducto: idProducto, idImpuesto: idImpuesto };
        try {
            const res = await fetch('/Productos/QuitarImpuesto', {
                method: 'POST',
                headers: Object.assign({}, headers, {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }),
                body: JSON.stringify(payload)
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                gestionarImpuestos(idProducto);
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    window.cambiarEstatus = cambiarEstatus;
    window.editar = editar;
    window.abrirModal = abrirModal;
    window.gestionarImpuestos = gestionarImpuestos;

    document.getElementById('formProducto').addEventListener('submit', function (ev) {
        ev.preventDefault();
        guardar();
    });

    document.getElementById('buscar').addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
            cargar(this.value.trim());
        }.bind(this), 300);
    });

    cargarCategorias();
    cargar('');
})();
</script>
}