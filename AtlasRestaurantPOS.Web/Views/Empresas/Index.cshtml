@{
    ViewData["Title"] = "Empresas";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Empresas</h1>
    <button type="button" class="btn btn-primary" onclick="abrirModal()">Nuevo</button>
</div>

<div class="mb-3">
    <input type="text" id="buscar" class="form-control" placeholder="Buscar por nombre, razón social o RFC..." />
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Razón Social</th>
                <th>RFC</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th>Estatus</th>
                <th>Fecha</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-empresas"></tbody>
    </table>
</div>

<div class="modal fade" id="modalEmpresa" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formEmpresa" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModal">Nueva empresa</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="IdEmpresa" />
                    <div class="mb-3">
                        <label class="form-label" for="Nombre">Nombre *</label>
                        <input type="text" id="Nombre" class="form-control" maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="RazonSocial">Razón social</label>
                        <input type="text" id="RazonSocial" class="form-control" maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Rfc">RFC</label>
                        <input type="text" id="Rfc" class="form-control" maxlength="20" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Telefono">Teléfono</label>
                        <input type="text" id="Telefono" class="form-control" maxlength="30" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Correo">Correo</label>
                        <input type="email" id="Correo" class="form-control" maxlength="200" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Toast")

@section Scripts {
<script>
(function () {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const modal = document.getElementById('modalEmpresa');
    let debounceTimer = null;

    const headers = {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
    };

    async function respuestaJson(res) {
        if (res.status === 401) { window.location.href = '/Acceso/Login'; return null; }
        if (res.status === 403) { mostrarToast('Acceso denegado.', 'error'); return null; }
        if (!res.ok) { mostrarToast('Error en la solicitud.', 'error'); return null; }
        return res.json();
    }

    async function cargar(termino) {
        const url = '/Empresas/Buscar?termino=' + encodeURIComponent(termino);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (data) renderizar(data);
        } catch (e) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    function renderizar(lista) {
        const tbody = document.getElementById('tabla-empresas');
        tbody.innerHTML = '';
        if (!lista.length) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center">Sin resultados</td></tr>';
            return;
        }
        lista.forEach(e => {
            const tr = document.createElement('tr');
            const badge = e.activo
                ? '<span class="badge bg-success">Activo</span>'
                : '<span class="badge bg-secondary">Inactivo</span>';
            const botonEstatus = e.activo
                ? '<button type="button" class="btn btn-sm btn-outline-warning" onclick="window.cambiarEstatus(' + e.idEmpresa + ', false)">Inactivar</button>'
                : '<button type="button" class="btn btn-sm btn-outline-success" onclick="window.cambiarEstatus(' + e.idEmpresa + ', true)">Activar</button>';
            tr.innerHTML = '<td>' + e.idEmpresa + '</td>' +
                '<td>' + escapeHtml(e.nombre) + '</td>' +
                '<td>' + escapeHtml(e.razonSocial || '') + '</td>' +
                '<td>' + escapeHtml(e.rfc || '') + '</td>' +
                '<td>' + escapeHtml(e.telefono || '') + '</td>' +
                '<td>' + escapeHtml(e.correo || '') + '</td>' +
                '<td>' + badge + '</td>' +
                '<td>' + new Date(e.fechaCreacion).toLocaleDateString() + '</td>' +
                '<td class="text-end text-nowrap">' +
                '<button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="window.editar(' + e.idEmpresa + ')">Editar</button>' +
                botonEstatus +
                '</td>';
            tbody.appendChild(tr);
        });
    }

    function abrirModal() {
        document.getElementById('formEmpresa').reset();
        document.getElementById('IdEmpresa').value = '';
        document.getElementById('tituloModal').textContent = 'Nueva empresa';
        new bootstrap.Modal(modal).show();
    }

    async function editar(id) {
        const url = '/Empresas/Buscar?termino=' + encodeURIComponent(id);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (!data) return;
            const e = data.find(x => x.idEmpresa === id);
            if (!e) { mostrarToast('No se encontró el registro.', 'error'); return; }
            document.getElementById('IdEmpresa').value = e.idEmpresa;
            document.getElementById('Nombre').value = e.nombre;
            document.getElementById('RazonSocial').value = e.razonSocial || '';
            document.getElementById('Rfc').value = e.rfc || '';
            document.getElementById('Telefono').value = e.telefono || '';
            document.getElementById('Correo').value = e.correo || '';
            document.getElementById('tituloModal').textContent = 'Editar empresa';
            new bootstrap.Modal(modal).show();
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function guardar() {
        const id = document.getElementById('IdEmpresa').value;
        const payload = {
            idEmpresa: id ? parseInt(id, 10) : 0,
            nombre: document.getElementById('Nombre').value,
            razonSocial: document.getElementById('RazonSocial').value,
            rfc: document.getElementById('Rfc').value,
            telefono: document.getElementById('Telefono').value,
            correo: document.getElementById('Correo').value
        };
        const url = payload.idEmpresa ? '/Empresas/Editar' : '/Empresas/Crear';
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }),
                body: JSON.stringify(payload)
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                bootstrap.Modal.getInstance(modal).hide();
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function cambiarEstatus(id, activar) {
        const accion = activar ? '¿Activar la empresa?' : '¿Inactivar la empresa?';
        if (!confirm(accion)) return;
        const url = activar ? '/Empresas/Activar?id=' + id : '/Empresas/Inactivar?id=' + id;
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, { 'RequestVerificationToken': token })
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    window.cambiarEstatus = cambiarEstatus;
    window.editar = editar;
    window.abrirModal = abrirModal;

    document.getElementById('formEmpresa').addEventListener('submit', function (ev) {
        ev.preventDefault();
        guardar();
    });

    document.getElementById('buscar').addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
            cargar(this.value.trim());
        }.bind(this), 300);
    });

    cargar('');
})();
</script>
}