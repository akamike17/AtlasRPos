@{
    ViewData["Title"] = "Unidades de Medida";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Unidades de Medida</h1>
    <button type="button" class="btn btn-primary" onclick="window.abrirModal()">Nuevo</button>
</div>

<div class="mb-3">
    <input type="text" id="buscar" class="form-control" placeholder="Buscar por código o nombre..." />
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Empresa</th>
                <th>Código</th>
                <th>Nombre</th>
                <th>Estatus</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-unidades"></tbody>
    </table>
</div>

<div class="modal fade" id="modalUnidad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formUnidad" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModal">Nueva unidad de medida</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="IdUnidadMedida" />
                    <div class="mb-3">
                        <label class="form-label" for="Codigo">Código *</label>
                        <input type="text" id="Codigo" class="form-control" maxlength="20" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Nombre">Nombre *</label>
                        <input type="text" id="Nombre" class="form-control" maxlength="100" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Toast")

@section Scripts {
<script>
(function () {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const modal = document.getElementById('modalUnidad');
    let debounceTimer = null;

    const headers = {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
    };

    async function respuestaJson(res) {
        if (res.status === 401) { window.location.href = '/Acceso/Login'; return null; }
        if (res.status === 403) { mostrarToast('Acceso denegado.', 'error'); return null; }
        if (!res.ok) { mostrarToast('Error en la solicitud.', 'error'); return null; }
        return res.json();
    }

    async function cargar(termino) {
        const url = '/UnidadesMedida/Buscar?termino=' + encodeURIComponent(termino);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (data) renderizar(data);
        } catch (e) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    function renderizar(lista) {
        const tbody = document.getElementById('tabla-unidades');
        tbody.innerHTML = '';
        if (!lista.length) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center">Sin resultados</td></tr>';
            return;
        }
        lista.forEach(u => {
            const tr = document.createElement('tr');
            const badge = u.activo
                ? '<span class="badge bg-success">Activo</span>'
                : '<span class="badge bg-secondary">Inactivo</span>';
            const botonEstatus = u.activo
                ? '<button type="button" class="btn btn-sm btn-outline-warning" onclick="window.cambiarEstatus(' + u.idUnidadMedida + ', false)">Inactivar</button>'
                : '<button type="button" class="btn btn-sm btn-outline-success" onclick="window.cambiarEstatus(' + u.idUnidadMedida + ', true)">Activar</button>';
            tr.innerHTML = '<td>' + u.idUnidadMedida + '</td>' +
                '<td>' + escapeHtml(u.empresa) + '</td>' +
                '<td>' + escapeHtml(u.codigo) + '</td>' +
                '<td>' + escapeHtml(u.nombre) + '</td>' +
                '<td>' + badge + '</td>' +
                '<td class="text-end text-nowrap">' +
                '<button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="window.editar(' + u.idUnidadMedida + ')">Editar</button>' +
                botonEstatus +
                '</td>';
            tbody.appendChild(tr);
        });
    }

    function abrirModal() {
        document.getElementById('formUnidad').reset();
        document.getElementById('IdUnidadMedida').value = '';
        document.getElementById('tituloModal').textContent = 'Nueva unidad de medida';
        new bootstrap.Modal(modal).show();
    }

    async function editar(id) {
        const url = '/UnidadesMedida/Obtener?id=' + id;
        try {
            const res = await fetch(url, { headers });
            const c = await respuestaJson(res);
            if (!c) return;
            if (c.ok === false) { mostrarToast(c.mensaje || 'No se encontró el registro.', 'error'); return; }
            document.getElementById('IdUnidadMedida').value = c.idUnidadMedida;
            document.getElementById('Codigo').value = c.codigo || '';
            document.getElementById('Nombre').value = c.nombre;
            document.getElementById('tituloModal').textContent = 'Editar unidad de medida';
            new bootstrap.Modal(modal).show();
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function guardar() {
        const id = document.getElementById('IdUnidadMedida').value;
        const payload = {
            idUnidadMedida: id ? parseInt(id, 10) : 0,
            codigo: document.getElementById('Codigo').value.trim(),
            nombre: document.getElementById('Nombre').value.trim()
        };
        const url = payload.idUnidadMedida ? '/UnidadesMedida/Editar' : '/UnidadesMedida/Crear';
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }),
                body: JSON.stringify(payload)
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                bootstrap.Modal.getInstance(modal).hide();
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function cambiarEstatus(id, activar) {
        const accion = activar ? '¿Activar la unidad de medida?' : '¿Inactivar la unidad de medida?';
        if (!confirm(accion)) return;
        const url = activar ? '/UnidadesMedida/Activar?id=' + id : '/UnidadesMedida/Inactivar?id=' + id;
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, { 'RequestVerificationToken': token })
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    window.cambiarEstatus = cambiarEstatus;
    window.editar = editar;
    window.abrirModal = abrirModal;

    document.getElementById('formUnidad').addEventListener('submit', function (ev) {
        ev.preventDefault();
        guardar();
    });

    document.getElementById('buscar').addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
            cargar(this.value.trim());
        }.bind(this), 300);
    });

    cargar('');
})();
</script>
}
