@{
    ViewData["Title"] = "Impuestos";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Impuestos</h1>
    <button type="button" class="btn btn-primary" onclick="window.abrirModal()">Nuevo</button>
</div>

<div class="mb-3">
    <input type="text" id="buscar" class="form-control" placeholder="Buscar por nombre..." />
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Empresa</th>
                <th>Nombre</th>
                <th>Tasa (%)</th>
                <th>Incluido en precio</th>
                <th>Estatus</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-impuestos"></tbody>
    </table>
</div>

<div class="modal fade" id="modalImpuesto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formImpuesto" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModal">Nuevo impuesto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="IdImpuesto" />
                    <div class="mb-3">
                        <label class="form-label" for="Nombre">Nombre *</label>
                        <input type="text" id="Nombre" class="form-control" maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Tasa">Tasa (%) *</label>
                        <input type="number" id="Tasa" class="form-control" step="0.0001" min="0" max="100" />
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" class="form-check-input" id="IncluidoEnPrecio" />
                        <label class="form-check-label" for="IncluidoEnPrecio">Incluido en el precio</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Toast")

@section Scripts {
<script>
(function () {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const modal = document.getElementById('modalImpuesto');
    let debounceTimer = null;

    const headers = {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
    };

    async function respuestaJson(res) {
        if (res.status === 401) { window.location.href = '/Acceso/Login'; return null; }
        if (res.status === 403) { mostrarToast('Acceso denegado.', 'error'); return null; }
        if (!res.ok) { mostrarToast('Error en la solicitud.', 'error'); return null; }
        return res.json();
    }

    async function cargar(termino) {
        const url = '/Impuestos/Buscar?termino=' + encodeURIComponent(termino);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (data) renderizar(data);
        } catch (e) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    function renderizar(lista) {
        const tbody = document.getElementById('tabla-impuestos');
        tbody.innerHTML = '';
        if (!lista.length) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center">Sin resultados</td></tr>';
            return;
        }
        lista.forEach(i => {
            const tr = document.createElement('tr');
            const badge = i.activo
                ? '<span class="badge bg-success">Activo</span>'
                : '<span class="badge bg-secondary">Inactivo</span>';
            const botonEstatus = i.activo
                ? '<button type="button" class="btn btn-sm btn-outline-warning" onclick="window.cambiarEstatus(' + i.idImpuesto + ', false)">Inactivar</button>'
                : '<button type="button" class="btn btn-sm btn-outline-success" onclick="window.cambiarEstatus(' + i.idImpuesto + ', true)">Activar</button>';
            const incluido = i.incluidoEnPrecio ? 'Sí' : 'No';
            tr.innerHTML = '<td>' + i.idImpuesto + '</td>' +
                '<td>' + escapeHtml(i.empresa) + '</td>' +
                '<td>' + escapeHtml(i.nombre) + '</td>' +
                '<td>' + Number(i.tasa).toFixed(2) + '</td>' +
                '<td>' + incluido + '</td>' +
                '<td>' + badge + '</td>' +
                '<td class="text-end text-nowrap">' +
                '<button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="window.editar(' + i.idImpuesto + ')">Editar</button>' +
                botonEstatus +
                '</td>';
            tbody.appendChild(tr);
        });
    }

    function abrirModal() {
        document.getElementById('formImpuesto').reset();
        document.getElementById('IdImpuesto').value = '';
        document.getElementById('IncluidoEnPrecio').checked = false;
        document.getElementById('tituloModal').textContent = 'Nuevo impuesto';
        new bootstrap.Modal(modal).show();
    }

    async function editar(id) {
        const url = '/Impuestos/Buscar?termino=' + encodeURIComponent(id);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (!data) return;
            const i = data.find(x => x.idImpuesto === id);
            if (!i) { mostrarToast('No se encontró el registro.', 'error'); return; }
            document.getElementById('IdImpuesto').value = i.idImpuesto;
            document.getElementById('Nombre').value = i.nombre;
            document.getElementById('Tasa').value = i.tasa;
            document.getElementById('IncluidoEnPrecio').checked = i.incluidoEnPrecio;
            document.getElementById('tituloModal').textContent = 'Editar impuesto';
            new bootstrap.Modal(modal).show();
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function guardar() {
        const id = document.getElementById('IdImpuesto').value;
        const payload = {
            idImpuesto: id ? parseInt(id, 10) : 0,
            nombre: document.getElementById('Nombre').value,
            tasa: parseFloat(document.getElementById('Tasa').value) || 0,
            incluidoEnPrecio: document.getElementById('IncluidoEnPrecio').checked
        };
        const url = payload.idImpuesto ? '/Impuestos/Editar' : '/Impuestos/Crear';
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }),
                body: JSON.stringify(payload)
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                bootstrap.Modal.getInstance(modal).hide();
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function cambiarEstatus(id, activar) {
        const accion = activar ? '¿Activar el impuesto?' : '¿Inactivar el impuesto?';
        if (!confirm(accion)) return;
        const url = activar ? '/Impuestos/Activar?id=' + id : '/Impuestos/Inactivar?id=' + id;
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, { 'RequestVerificationToken': token })
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    window.cambiarEstatus = cambiarEstatus;
    window.editar = editar;
    window.abrirModal = abrirModal;

    document.getElementById('formImpuesto').addEventListener('submit', function (ev) {
        ev.preventDefault();
        guardar();
    });

    document.getElementById('buscar').addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
            cargar(this.value.trim());
        }.bind(this), 300);
    });

    cargar('');
})();
</script>
}