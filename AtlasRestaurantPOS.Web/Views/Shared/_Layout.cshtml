@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AtlasRestaurantPOS.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AtlasRestaurantPOS.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AtlasRestaurantPOS.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="CajaOperacion" asp-action="Seleccionar">Operación de Caja</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Ventas" asp-action="Index">Punto de Venta</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Salon" asp-action="Index">Salón / Mesas</a>
                        </li>
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Empresas" asp-action="Index">Empresas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Sucursales" asp-action="Index">Sucursales</a></li>
                                    <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index">Roles</a></li>
                                    <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                                    <li><a class="dropdown-item" asp-controller="Cajas" asp-action="Index">Cajas</a></li>
                                    <li><a class="dropdown-item" asp-controller="Mesas" asp-action="Index">Mesas</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Categorias" asp-action="Index">Categorías</a></li>
                                    <li><a class="dropdown-item" asp-controller="Productos" asp-action="Index">Productos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Impuestos" asp-action="Index">Impuestos</a></li>
                                    <li><a class="dropdown-item" asp-controller="MetodosPago" asp-action="Index">Métodos de Pago</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.HasClaim(c => c.Type == "IdCaja") && User.HasClaim(c => c.Type == "IdSesionCaja"))
                            {
                                <li class="nav-item">
                                    <span class="nav-link text-dark">
                                        Caja: @User.FindFirstValue("CajaNombre") (@User.FindFirstValue("CajaCodigo"))
                                    </span>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <span class="nav-link text-dark">Sin caja abierta</span>
                                </li>
                            }
                            <li class="nav-item">
                                <span class="nav-link text-dark">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Acceso" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link text-dark">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AtlasRestaurantPOS.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
