@{
    ViewData["Title"] = "Mesas";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Mesas</h1>
    <button type="button" class="btn btn-primary" onclick="window.abrirModal()">Nuevo</button>
</div>

<div class="mb-3">
    <input type="text" id="buscar" class="form-control" placeholder="Buscar por nombre, sucursal o empresa..." />
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Empresa</th>
                <th>Sucursal</th>
                <th>Nombre</th>
                <th>Capacidad</th>
                <th>Estado operacional</th>
                <th>Estatus</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-mesas"></tbody>
    </table>
</div>

<div class="modal fade" id="modalMesa" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formMesa" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModal">Nueva mesa</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="IdMesa" />
                    <div class="mb-3">
                        <label class="form-label" for="IdSucursal">Sucursal *</label>
                        <select id="IdSucursal" class="form-select"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Nombre">Nombre *</label>
                        <input type="text" id="Nombre" class="form-control" maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Capacidad">Capacidad *</label>
                        <input type="number" id="Capacidad" class="form-control" min="1" step="1" />
                    </div>
                    <p class="text-muted small mb-0">El estado operacional no se edita desde la administración.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Toast")

@section Scripts {
<script>
(function () {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const modalEl = document.getElementById('modalMesa');
    const modal = new bootstrap.Modal(modalEl);
    const selectSucursal = document.getElementById('IdSucursal');
    let debounceTimer = null;

    const headers = {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
    };

    async function respuestaJson(res) {
        if (res.status === 401) { window.location.href = '/Acceso/Login'; return null; }
        if (res.status === 403) { mostrarToast('Acceso denegado.', 'error'); return null; }
        if (!res.ok) { mostrarToast('Error en la solicitud.', 'error'); return null; }
        return res.json();
    }

    async function cargar(termino) {
        const url = '/Mesas/Buscar?termino=' + encodeURIComponent(termino);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (data) renderizar(data);
        } catch (e) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    function renderizar(lista) {
        const tbody = document.getElementById('tabla-mesas');
        tbody.innerHTML = '';
        if (!lista.length) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center">Sin resultados</td></tr>';
            return;
        }
        lista.forEach(m => {
            const tr = document.createElement('tr');
            const badgeActivo = m.activo
                ? '<span class="badge bg-success">Activo</span>'
                : '<span class="badge bg-secondary">Inactivo</span>';
            const badgeEstado = badgeEstadoMesa(m.estado);
            const botonEstatus = m.activo
                ? '<button type="button" class="btn btn-sm btn-outline-warning" onclick="window.cambiarEstatus(' + m.idMesa + ', false)">Inactivar</button>'
                : '<button type="button" class="btn btn-sm btn-outline-success" onclick="window.cambiarEstatus(' + m.idMesa + ', true)">Activar</button>';
            tr.innerHTML = '<td>' + m.idMesa + '</td>' +
                '<td>' + escapeHtml(m.empresa) + '</td>' +
                '<td>' + escapeHtml(m.sucursal) + '</td>' +
                '<td>' + escapeHtml(m.nombre) + '</td>' +
                '<td>' + m.capacidad + '</td>' +
                '<td>' + badgeEstado + '</td>' +
                '<td>' + badgeActivo + '</td>' +
                '<td class="text-end text-nowrap">' +
                '<button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="window.editar(' + m.idMesa + ')">Editar</button>' +
                botonEstatus +
                '</td>';
            tbody.appendChild(tr);
        });
    }

    function badgeEstadoMesa(estado) {
        switch (estado) {
            case 'OCUPADA': return '<span class="badge bg-warning text-dark">Ocupada</span>';
            case 'RESERVADA': return '<span class="badge bg-info text-dark">Reservada</span>';
            case 'FUERA_SERVICIO': return '<span class="badge bg-secondary">Fuera de servicio</span>';
            default: return '<span class="badge bg-success">Disponible</span>';
        }
    }

    async function cargarSucursales() {
        try {
            const res = await fetch('/Sucursales/Buscar', { headers });
            const data = await respuestaJson(res);
            if (!data) return;
            selectSucursal.innerHTML = '<option value="">Seleccione...</option>';
            data.filter(s => s.activo).forEach(s => {
                const op = document.createElement('option');
                op.value = s.idSucursal;
                op.textContent = s.nombre + ' (' + s.empresa + ')';
                selectSucursal.appendChild(op);
            });
        } catch (err) {
            mostrarToast('Error al cargar sucursales.', 'error');
        }
    }

    function abrirModal() {
        document.getElementById('formMesa').reset();
        document.getElementById('IdMesa').value = '';
        document.getElementById('tituloModal').textContent = 'Nueva mesa';
        modal.show();
    }

    async function editar(id) {
        const url = '/Mesas/Obtener?id=' + id;
        try {
            const res = await fetch(url, { headers });
            const c = await respuestaJson(res);
            if (!c) return;
            if (c.ok === false) { mostrarToast(c.mensaje || 'No se encontró el registro.', 'error'); return; }
            document.getElementById('IdMesa').value = c.idMesa;
            document.getElementById('IdSucursal').value = c.idSucursal;
            document.getElementById('Nombre').value = c.nombre;
            document.getElementById('Capacidad').value = c.capacidad;
            document.getElementById('tituloModal').textContent = 'Editar mesa';
            modal.show();
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function guardar() {
        const id = document.getElementById('IdMesa').value;
        const payload = {
            idMesa: id ? parseInt(id, 10) : 0,
            idSucursal: parseInt(document.getElementById('IdSucursal').value, 10) || 0,
            nombre: document.getElementById('Nombre').value,
            capacidad: parseInt(document.getElementById('Capacidad').value, 10) || 0
        };
        const url = payload.idMesa ? '/Mesas/Editar' : '/Mesas/Crear';
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }),
                body: JSON.stringify(payload)
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                modal.hide();
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function cambiarEstatus(id, activar) {
        const accion = activar ? '¿Activar la mesa?' : '¿Inactivar la mesa?';
        if (!confirm(accion)) return;
        const url = activar ? '/Mesas/Activar?id=' + id : '/Mesas/Inactivar?id=' + id;
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, { 'RequestVerificationToken': token })
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    window.cambiarEstatus = cambiarEstatus;
    window.editar = editar;
    window.abrirModal = abrirModal;

    document.getElementById('formMesa').addEventListener('submit', function (ev) {
        ev.preventDefault();
        guardar();
    });

    document.getElementById('buscar').addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
            cargar(this.value.trim());
        }.bind(this), 300);
    });

    cargarSucursales();
    cargar('');
})();
</script>
}