@{
    ViewData["Title"] = "Sucursales";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Sucursales</h1>
    <button type="button" class="btn btn-primary" onclick="window.abrirModal()">Nuevo</button>
</div>

<div class="mb-3">
    <input type="text" id="buscar" class="form-control" placeholder="Buscar por nombre o empresa..." />
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Empresa</th>
                <th>Nombre</th>
                <th>Dirección</th>
                <th>Teléfono</th>
                <th>Estatus</th>
                <th>Fecha</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody id="tabla-sucursales"></tbody>
    </table>
</div>

<div class="modal fade" id="modalSucursal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formSucursal" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModal">Nueva sucursal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="IdSucursal" />
                    <div class="mb-3">
                        <label class="form-label" for="IdEmpresa">Empresa *</label>
                        <select id="IdEmpresa" class="form-select"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Nombre">Nombre *</label>
                        <input type="text" id="Nombre" class="form-control" maxlength="150" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Direccion">Dirección</label>
                        <input type="text" id="Direccion" class="form-control" maxlength="500" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Telefono">Teléfono</label>
                        <input type="text" id="Telefono" class="form-control" maxlength="30" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Toast")

@section Scripts {
<script>
(function () {
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const modal = document.getElementById('modalSucursal');
    const selectEmpresa = document.getElementById('IdEmpresa');
    let debounceTimer = null;

    const headers = {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
    };

    async function respuestaJson(res) {
        if (res.status === 401) { window.location.href = '/Acceso/Login'; return null; }
        if (res.status === 403) { mostrarToast('Acceso denegado.', 'error'); return null; }
        if (!res.ok) { mostrarToast('Error en la solicitud.', 'error'); return null; }
        return res.json();
    }

    async function cargar(termino) {
        const url = '/Sucursales/Buscar?termino=' + encodeURIComponent(termino);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (data) renderizar(data);
        } catch (e) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    function renderizar(lista) {
        const tbody = document.getElementById('tabla-sucursales');
        tbody.innerHTML = '';
        if (!lista.length) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center">Sin resultados</td></tr>';
            return;
        }
        lista.forEach(s => {
            const tr = document.createElement('tr');
            const badge = s.activo
                ? '<span class="badge bg-success">Activo</span>'
                : '<span class="badge bg-secondary">Inactivo</span>';
            const botonEstatus = s.activo
                ? '<button type="button" class="btn btn-sm btn-outline-warning" onclick="window.cambiarEstatus(' + s.idSucursal + ', false)">Inactivar</button>'
                : '<button type="button" class="btn btn-sm btn-outline-success" onclick="window.cambiarEstatus(' + s.idSucursal + ', true)">Activar</button>';
            tr.innerHTML = '<td>' + s.idSucursal + '</td>' +
                '<td>' + escapeHtml(s.empresa) + '</td>' +
                '<td>' + escapeHtml(s.nombre) + '</td>' +
                '<td>' + escapeHtml(s.direccion || '') + '</td>' +
                '<td>' + escapeHtml(s.telefono || '') + '</td>' +
                '<td>' + badge + '</td>' +
                '<td>' + new Date(s.fechaCreacion).toLocaleDateString() + '</td>' +
                '<td class="text-end text-nowrap">' +
                '<button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="window.editar(' + s.idSucursal + ')">Editar</button>' +
                botonEstatus +
                '</td>';
            tbody.appendChild(tr);
        });
    }

    async function cargarEmpresas() {
        try {
            const res = await fetch('/Empresas/Buscar', { headers });
            const data = await respuestaJson(res);
            if (!data) return;
            selectEmpresa.innerHTML = '<option value="">Seleccione...</option>';
            data.filter(e => e.activo).forEach(e => {
                const op = document.createElement('option');
                op.value = e.idEmpresa;
                op.textContent = e.nombre;
                selectEmpresa.appendChild(op);
            });
        } catch (err) {
            mostrarToast('Error al cargar empresas.', 'error');
        }
    }

    function abrirModal() {
        document.getElementById('formSucursal').reset();
        document.getElementById('IdSucursal').value = '';
        document.getElementById('tituloModal').textContent = 'Nueva sucursal';
        new bootstrap.Modal(modal).show();
    }

    async function editar(id) {
        const url = '/Sucursales/Buscar?termino=' + encodeURIComponent(id);
        try {
            const res = await fetch(url, { headers });
            const data = await respuestaJson(res);
            if (!data) return;
            const s = data.find(x => x.idSucursal === id);
            if (!s) { mostrarToast('No se encontró el registro.', 'error'); return; }
            document.getElementById('IdSucursal').value = s.idSucursal;
            document.getElementById('IdEmpresa').value = s.idEmpresa;
            document.getElementById('Nombre').value = s.nombre;
            document.getElementById('Direccion').value = s.direccion || '';
            document.getElementById('Telefono').value = s.telefono || '';
            document.getElementById('tituloModal').textContent = 'Editar sucursal';
            new bootstrap.Modal(modal).show();
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function guardar() {
        const id = document.getElementById('IdSucursal').value;
        const payload = {
            idSucursal: id ? parseInt(id, 10) : 0,
            idEmpresa: parseInt(document.getElementById('IdEmpresa').value, 10) || 0,
            nombre: document.getElementById('Nombre').value,
            direccion: document.getElementById('Direccion').value,
            telefono: document.getElementById('Telefono').value
        };
        const url = payload.idSucursal ? '/Sucursales/Editar' : '/Sucursales/Crear';
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }),
                body: JSON.stringify(payload)
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                bootstrap.Modal.getInstance(modal).hide();
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    async function cambiarEstatus(id, activar) {
        const accion = activar ? '¿Activar la sucursal?' : '¿Inactivar la sucursal?';
        if (!confirm(accion)) return;
        const url = activar ? '/Sucursales/Activar?id=' + id : '/Sucursales/Inactivar?id=' + id;
        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: Object.assign({}, headers, { 'RequestVerificationToken': token })
            });
            const r = await respuestaJson(res);
            if (!r) return;
            if (r.ok) {
                mostrarToast(r.mensaje, 'ok');
                cargar(document.getElementById('buscar').value.trim());
            } else {
                mostrarToast(r.mensaje, 'error');
            }
        } catch (err) {
            mostrarToast('Error de conexión.', 'error');
        }
    }

    window.cambiarEstatus = cambiarEstatus;
    window.editar = editar;
    window.abrirModal = abrirModal;

    document.getElementById('formSucursal').addEventListener('submit', function (ev) {
        ev.preventDefault();
        guardar();
    });

    document.getElementById('buscar').addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function () {
            cargar(this.value.trim());
        }.bind(this), 300);
    });

    cargarEmpresas();
    cargar('');
})();
</script>
}